{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product_identity_archive.schema.json",
  "title": "Product Identity Archive",
  "type": "object",
  "required": ["product_id", "artifact_type", "source_inputs", "identity"],
  "properties": {
    "product_id": { "type": "string", "minLength": 1 },
    "artifact_type": { "const": "product_identity_archive" },
    "source_inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "identity": {
      "type": "object"
    },
    "missing_information": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocked_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  },
  "not": {
    "anyOf": [
      { "required": ["angle_slots"] },
      { "required": ["variable_configs"] },
      { "required": ["final_prompt"] },
      { "required": ["qc_results"] }
    ]
  },
  "additionalProperties": true
}
