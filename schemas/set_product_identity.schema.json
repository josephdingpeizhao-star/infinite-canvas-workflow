{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "set_product_identity.schema.json",
  "title": "Set Product Identity",
  "type": "object",
  "required": ["product_id", "artifact_type", "set_identity", "components"],
  "properties": {
    "product_id": { "type": "string", "minLength": 1 },
    "artifact_type": { "const": "set_product_identity" },
    "user_declared_set_product": {
      "type": "boolean",
      "default": false
    },
    "explicit_set_request": {
      "type": ["string", "object"]
    },
    "set_identity": { "type": "object" },
    "components": {
      "type": "array",
      "items": { "type": "object" }
    },
    "missing_information": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  },
  "anyOf": [
    {
      "properties": {
        "user_declared_set_product": { "const": true }
      },
      "required": ["user_declared_set_product"]
    },
    {
      "required": ["explicit_set_request"]
    }
  ],
  "not": {
    "anyOf": [
      { "required": ["angle_slots"] },
      { "required": ["variable_configs"] },
      { "required": ["final_prompt"] },
      { "required": ["qc_results"] }
    ]
  },
  "additionalProperties": true
}
